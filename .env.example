# Copy this file to `.env` and fill in the values.
# None of these values are checked into source control.

# Supabase / Lovable Cloud
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Live agent worker (optional for fixture-only demos)
AGENT_WORKER_URL="http://localhost:3000"
AGENT_SHARED_SECRET="any-shared-secret"

# Browserbase (used by the agent worker and preflight)
BROWSERBASE_API_KEY="bb_live_..."
BROWSERBASE_API_KEYS="bb_live_...,bb_live_..."

# LLM provider (used by the agent worker)
OPENAI_API_KEY="sk-..."
# Optional: set this to https://openrouter.ai/api/v1 to use OpenRouter
OPENAI_BASE_URL=""
